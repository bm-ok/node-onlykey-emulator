{
  "name": "emulator",
  "version": "1.0.0",
  "description": "OnlyKey hardware emulator - runs the unmodified OnlyKey firmware as a Node native addon",
  "main": "index.js",
  "scripts": {
    "stage": "node scripts/stage.js && node scripts/gen-sources.js",
    "configure": "npm run stage && node-gyp configure -Dnode_with_ltcg=false",
    "build": "npm run stage && node-gyp build",
    "rebuild": "npm run stage && node-gyp configure -Dnode_with_ltcg=false && node-gyp build",
    "smoke": "npm run build && node test/smoke.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "gypfile": true,
  "dependencies": {
    "node-addon-api": "^8.9.1",
    "node-gyp": "^13.0.1",
    "node-onlykey-lib": "github:bmatusiak/node-onlykey-lib#93d2b2d8310fc52c5db0c82a4a8c892e4f9939a1"
  }
}
